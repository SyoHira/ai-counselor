# Anthropic（必須）
ANTHROPIC_API_KEY=

# 任意。キーがある場合のみ、そのプロバイダが計測対象に加わる。
# 有効化する前に、各社の利用規約で「回答の記録・比較・第三者への提供」が
# 許容されているかを必ず確認すること。
OPENAI_API_KEY=
GEMINI_API_KEY=

# 計測に使うモデル（未設定なら既定値）
ANTHROPIC_MODEL=claude-opus-5
OPENAI_MODEL=
GEMINI_MODEL=

# 分類（言及・論調の判定）に使うモデル
CLASSIFIER_MODEL=claude-opus-5

# 1問あたりの試行回数。回答の揺らぎと実際の変化を区別するために3以上。
RUNS_PER_QUESTION=3

# 同時実行数
CONCURRENCY=4
