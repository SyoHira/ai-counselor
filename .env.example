ANTHROPIC_API_KEY=your-api-key-here

# Studio / Engine（/studio, /studio/engine）
STUDIO_PASSWORD=
# STUDIO_MODEL=claude-opus-5-5

# データベース。未設定ならローカルの PGlite（.data/pglite）。本番は Postgres（Neon / Supabase など）
DATABASE_URL=

# 定期実行（GitHub Actions → /api/cron/<job>）の認証
CRON_SECRET=
# 公開URL（/go/<slug> の計測リンクに使う）
PUBLIC_BASE_URL=

# 楽天（ランキング取得・アフィリエイトURL付与）
RAKUTEN_APP_ID=
RAKUTEN_AFFILIATE_ID=
# RAKUTEN_GENRES=100938,100804,100939

# Amazon アソシエイト（Creators API。直近30日で10件以上の適格売上が必要。無ければ ASIN 手動登録で運用）
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
# AMAZON_CREDENTIAL_VERSION=3.3   # 日本（Far East）。2.x の場合は 2.3
AMAZON_PARTNER_TAG=
# 商品別の成果を取るためのトラッキングID（カンマ区切り。アソシエイト管理画面で作成）
AMAZON_TRACKING_IDS=
# AMAZON_KEYWORDS=睡眠 グッズ,アイマスク,枕,リラックス

# Threads（Meta の開発者アプリで発行した長期アクセストークン）
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# LINE公式アカウント（Messaging API。Webhook URL は <PUBLIC_BASE_URL>/api/line/webhook）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LINE_AI_DAILY_LIMIT=5

# 高単価案件リサーチの対象カテゴリ（カンマ区切り）
# OFFER_CATEGORIES=オンラインカウンセリング,転職エージェント,退職代行,婚活・結婚相談所,コーチング・キャリア相談,睡眠（マットレス・寝具）
# DEFAULT_APPROVAL_RATE=0.5

# 運用パラメータ
AUTO_PUBLISH=false        # true: 判定を通った投稿・LINE本文・ガイドを人の承認なしで公開
LINK_MODE=reply           # reply: 投稿への返信でリンク / none: プロフィール誘導のみ
# POSTS_PER_DAY=3
# ACTIVE_PRODUCTS=10
# PRICE_TARGET=5000
# MIN_VIEWS_TO_JUDGE=3000
# RETIRE_PROB_BEST=0.02
